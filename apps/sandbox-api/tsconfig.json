{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["esnext"],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noErrorTruncation": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/importMeta"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
