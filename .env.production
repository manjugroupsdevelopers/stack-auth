# Stack Auth Production Environment Configuration
# IMPORTANT: Update these values for production use!

# ============================================
# CRITICAL SECURITY SETTINGS - MUST CHANGE!
# ============================================
# Generate a secure random string for this value (at least 32 characters)
# You can use: openssl rand -base64 32
STACK_SERVER_SECRET=BYVFNZ59iMXkhTTkl26JwIg7WZXMF2jjQ4CPPQjDjDc=

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For Docker Compose: use 'postgres' as hostname
# For standalone Docker: use 'host.docker.internal'
POSTGRES_PASSWORD=password
STACK_DATABASE_CONNECTION_STRING=postgresql://postgres:password@postgres:5432/stackframe

# ============================================
# EMAIL CONFIGURATION (REQUIRED)
# ============================================
# Get your API key from https://freestyle.sh
STACK_FREESTYLE_API_KEY=YOUR_FREESTYLE_API_KEY_HERE
STACK_JS_EXECUTION_ENGINE=legacy
STACK_SANDBOX_API_URL=http://sandbox-api.stack-auth-sandbox.svc.cluster.local:8080
STACK_SANDBOX_API_TOKEN=YOUR_SANDBOX_API_TOKEN_HERE
STACK_SANDBOX_TIMEOUT_MS=30000
STACK_SANDBOX_ALLOWED_MODULES=react@19.1.1,react-dom@19.1.1,@react-email/components@1.0.6,arktype@2.1.20

# ============================================
# SERVER CONFIGURATION
# ============================================
# The URL where your Stack Auth backend will be accessible
NEXT_PUBLIC_STACK_API_URL=http://localhost:8102

# The URL where your Stack Auth dashboard will be accessible
NEXT_PUBLIC_STACK_DASHBOARD_URL=http://localhost:8101

# ============================================
# OPTIONAL: WEBHOOK CONFIGURATION (Svix)
# ============================================
# If you want to use webhooks, configure Svix
# STACK_SVIX_URL=https://your-svix-instance.com
# STACK_SVIX_API_KEY=your-svix-api-key

# ============================================
# OPTIONAL: S3 STORAGE CONFIGURATION
# ============================================
# For production, configure real S3 storage
# STACK_AWS_S3_BUCKET=your-bucket-name
# STACK_AWS_ACCESS_KEY_ID=your-access-key
# STACK_AWS_SECRET_ACCESS_KEY=your-secret-key
# STACK_AWS_REGION=us-east-1

# ============================================
# OPTIONAL: CLICKHOUSE (Analytics)
# ============================================
# ClickHouse provides advanced analytics and event tracking
# Leave empty to skip (analytics features will be disabled)
# If you want analytics, set up ClickHouse and configure:
# STACK_CLICKHOUSE_URL=http://your-clickhouse-host:8123
# STACK_CLICKHOUSE_ADMIN_USER=stackframe
# STACK_CLICKHOUSE_ADMIN_PASSWORD=your-password
# STACK_CLICKHOUSE_EXTERNAL_PASSWORD=your-external-password
STACK_CLICKHOUSE_URL=
STACK_CLICKHOUSE_ADMIN_USER=
STACK_CLICKHOUSE_ADMIN_PASSWORD=
STACK_CLICKHOUSE_EXTERNAL_PASSWORD=

# ============================================
# SEED SCRIPT CONFIGURATION
# ============================================
# These settings control the initial project setup

# Enable user sign-up (set to true to allow new users to register)
STACK_SEED_INTERNAL_PROJECT_SIGN_UP_ENABLED=true

# Allow localhost for development/testing (set to false in production)
STACK_SEED_INTERNAL_PROJECT_ALLOW_LOCALHOST=true

# Enable OTP (One-Time Password) authentication
STACK_SEED_INTERNAL_PROJECT_OTP_ENABLED=true

# OAuth providers to enable (comma-separated list)
# Options: github,google,facebook,microsoft,apple,discord,spotify,gitlab,linkedin,x,slack
# STACK_SEED_INTERNAL_PROJECT_OAUTH_PROVIDERS=github,google

# Default admin user (for initial dashboard access)
STACK_SEED_INTERNAL_PROJECT_USER_EMAIL=admin@localhost.com
STACK_SEED_INTERNAL_PROJECT_USER_PASSWORD=admin123456
STACK_SEED_INTERNAL_PROJECT_USER_INTERNAL_ACCESS=true

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production
